{
  "manifest_version": 3,
  "name": "GRAFIQ Clipper",
  "version": "0.1.0",
  "description": "Save the freelancer profile you are looking at into GRAFIQ OS Sourcing — one profile at a time, as yourself.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to GRAFIQ OS"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
