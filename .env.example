# Supabase project settings → API
# Both values are safe to expose to the browser; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy projects may still use the "anon" key. It works as a fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: enables "Re-score with AI" in Sourcing (server-side only).
# ANTHROPIC_API_KEY=sk-ant-...
