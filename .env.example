# Supabase project settings → API
# Both values are safe to expose to the browser; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy projects may still use the "anon" key. It works as a fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: enables "Re-score with AI" in Sourcing and AI-drafted pricing plans in Pricing (server-side only).
# Without it, pricing plans are drafted from the estimate's cost lines.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: raises GitHub API limits for the Sourcing "GitHub developers" connector
# (fine-grained token, no scopes needed).
# GITHUB_TOKEN=github_pat_...

# Optional: enables the public /apply form (server-only, bypasses RLS — never expose).
# Public pricing-plan links /p/<token> do NOT need it (they use the get_shared_proposal function, migration 0014).
# Supabase → Project Settings → API → service_role (secret).
# SUPABASE_SERVICE_ROLE_KEY=...

# Required by the Hermes MCP endpoint at /api/mcp (server-side only).
# A long random string, e.g. `openssl rand -base64 48`. Requests without a
# matching `Authorization: Bearer <token>` header get 401. Tokens shorter than
# 24 characters are treated as unset and the endpoint refuses everything.
# HERMES_API_TOKEN=...
#
# The MCP endpoint also needs SUPABASE_SERVICE_ROLE_KEY above: Hermes has no
# user account, so RLS cannot scope it. Access is limited by the endpoint's
# fixed set of queries instead — never by a table or SQL sent from outside.
